{
  "name": "akra-hookers-desktop",
  "productName": "Akra Hookers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "npm run prepare && node scripts/build.mjs",
    "prepare": "npm run prepare:rust && npm run prepare:web && node scripts/prepare-resources.mjs",
    "prepare:rust": "cargo build --manifest-path ../Cargo.toml -p akra-app --bin akra-hookers --release",
    "prepare:web": "npm --prefix ../web run build",
    "start": "npm run prepare && electron .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^43.0.0"
  }
}
